<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp"/>
    <solid android:color="#041D67" />
    <stroke
        android:width="1dp"
        android:color="@android:color/black"/>
    <gradient
        android:angle="180"
        android:centerX="0.5"
        android:centerY="0.5"
        android:centerColor="@color/dark_bg2"
        android:endColor="@color/dark_bg3"
        android:gradientRadius="0"
        android:startColor="@color/dark_bg3"
        android:type="linear"
    android:useLevel="true"/>


</shape>