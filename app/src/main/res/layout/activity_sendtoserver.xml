<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Sendtoserver">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nouvelle_annonce_step3_phototaken_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/ee" />

        <TextView
            android:id="@+id/nouvelle_annonce_step3_texteHaut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TextView"
            android:textAlignment="center" />

        <Button
            android:id="@+id/nouvelle_annonce_step3_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Button"
            tools:ignore="MissingConstraints" />

        <ImageButton
            android:id="@+id/nouvelle_annonce_choose_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/address_card_20" />

        <ImageView
            android:id="@+id/imgfromurl_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ee" />

        <Button
            android:id="@+id/getfromurl_btn_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Button" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>