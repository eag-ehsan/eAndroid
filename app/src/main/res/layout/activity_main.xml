<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A1EAFD"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/rooteroot"
    >


    <ImageView
        android:id="@+id/tumbnail_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/ee"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/please_wait_for_login_id"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_bg3"
        android:gravity="center_horizontal|top"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:src="@drawable/d4"
            app:srcCompat="@drawable/d4" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="40dp"
                android:layout_height="70dp"
                android:src="@drawable/address_card_20"
                app:srcCompat="@drawable/address_card_20" />

            <TextView
                android:id="@+id/textView11"
                style="@style/Vazir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:text="@string/lng_login_txt11"
                android:textColor="@color/light_text2"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/username_please_wait_login"
            style="@style/Vazir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="TextView"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="27dp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/hourglass_clock"
            app:srcCompat="@drawable/hourglass_clock" />

    </LinearLayout>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toolicolor"
        android:gravity="left|center_vertical"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ToolbarTheme"
        app:titleTextColor="#FFFFFF">

        <TextView
            android:id="@+id/toolbarTextView3"
            style="@style/Yekan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="left|center_vertical"
            android:maxLines="1"
            android:text="@string/lng_tophead"
            android:textAppearance="@android:style/TextAppearance.WindowTitle"
            android:textSize="20sp"
            android:visibility="visible" />

        <Space
            android:layout_width="5dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/toolbarTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:ellipsize="end"
            android:gravity="left|center_vertical"
            android:maxLines="1"
            android:text="me"
            android:textAppearance="@android:style/TextAppearance.WindowTitle"
            android:textSize="20sp"
            android:visibility="visible" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dialogPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1"
        android:background="#FFEBEB"
        android:backgroundTint="#FDF7DB"
        android:backgroundTintMode="multiply"
        android:orientation="horizontal"
        android:visibility="gone">

        <Space
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <Space
                android:layout_width="match_parent"
                android:layout_height="112dp" />

            <TextView
                android:id="@+id/vtxtDialogMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="37dp" />

            <Button
                android:id="@+id/dialogOK"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OK" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="50dp" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lng_copyright"
                android:textAlignment="center"
                android:textSize="12sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="15dp" />

            <TextView
                android:id="@+id/ourartaglink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:text="https://www.ourartag.com"
                android:textAlignment="center"
                android:textSize="12sp" />

        </LinearLayout>

        <Space
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mainAppStatus"
            style="@style/Vazir"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.5"
            android:background="@color/header_footer_bg"
            android:text="@string/lng_mainStatus"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="16sp" />


        <LinearLayout
            android:id="@+id/radif1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="84"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/my_custom_background"
                android:gravity="start|top"
                android:orientation="vertical"
                android:paddingLeft="6dp"
                android:paddingTop="6dp"
                android:paddingRight="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/panelbala_id"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="9"
                    android:background="@drawable/my_bg_1"
                    android:orientation="vertical"
                    android:paddingLeft="6dp"
                    android:paddingTop="6dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="60"
                        android:background="@drawable/my_bg_2"
                        android:gravity="center"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/nameAnySelectUser_id"
                            style="@style/Vazir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_weight="1"
                            android:text="@string/lng_selectusr"
                            android:textColor="@color/light_text1" />

                        <TextView
                            android:id="@+id/online_txtid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="0"
                            android:text="@string/lng_online"
                            android:textColor="@color/light_bg2" />

                        <ImageView
                            android:id="@+id/online_imgid"
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ledoff" />

                        <TextView
                            android:id="@+id/seen_txtid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp"
                            android:text="@string/lng_seen"
                            android:textColor="@color/light_bg2" />

                        <ImageView
                            android:id="@+id/seen_imgid"
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ledg" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="81"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerView"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="90" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="500dp"
                            android:layout_weight="10"
                            android:gravity="center_horizontal|center_vertical"
                            android:orientation="vertical">


                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/main_fab1"
                                android:layout_width="70dp"
                                android:layout_height="35dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginLeft="2dp"
                                android:layout_marginBottom="12dp"
                                android:src="@drawable/gear_50"
                                android:tint="#FFFFFF"
                                app:fabCustomSize="35dp" />

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/main_fab2"
                                android:layout_width="70dp"
                                android:layout_height="35dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginLeft="2dp"
                                android:layout_marginBottom="12dp"
                                android:src="@drawable/arrows_rotate_50"
                                android:tint="#FFFFFF"
                                app:fabCustomSize="35dp" />

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/main_fab3"
                                android:layout_width="70dp"
                                android:layout_height="35dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginLeft="2dp"
                                android:layout_marginBottom="12dp"
                                android:src="@drawable/gallery_thumbnails_50"
                                android:tint="#FFFFFF"
                                app:fabCustomSize="37dp" />

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/main_fab4"
                                android:layout_width="70dp"
                                android:layout_height="35dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginLeft="2dp"
                                android:layout_marginBottom="12dp"
                                android:src="@drawable/location_smile"
                                android:tint="#FFFFFF"
                                app:fabCustomSize="35dp" />

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/main_fab5"
                                android:layout_width="70dp"
                                android:layout_height="35dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginLeft="2dp"
                                android:layout_marginBottom="12dp"
                                android:src="@drawable/microphone_50"
                                android:tint="#FFFFFF"
                                app:fabCustomSize="35dp" />

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/main_fab6"
                                android:layout_width="70dp"
                                android:layout_height="35dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginLeft="2dp"
                                android:layout_marginBottom="12dp"
                                android:src="@drawable/paperclip_50"
                                android:tint="#FFFFFF"
                                app:fabCustomSize="35dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/reply_layout_id"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="7"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/reply_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:padding="2dp"
                android:text="Nobody1"
                android:textColor="@color/dark_bg3"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reply_msg"
                style="@style/Vazir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"

                android:layout_weight="80"
                android:text="TextView"
                android:textSize="12sp"
                android:textStyle="normal" />

            <ImageButton
                android:id="@+id/reply_close"
                android:layout_width="25dp"
                android:layout_height="25dp"

                android:src="@drawable/circle_xmark_20" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/radif2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="7.5"
            android:background="@color/header_footer_bg"
            android:gravity="center"
            android:orientation="horizontal">


            <EditText
                android:id="@+id/txtChatToSend"
                style="@style/Vazir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="80"
                android:background="#FFFFFF"
                android:inputType="text"

                android:textSize="16dp"
                android:visibility="visible"
                tools:ignore="TouchTargetSizeCheck" />
            <ImageButton
                android:id="@+id/sendBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="10"
                android:background="@color/header_footer_bg"
                android:src="@drawable/paper_plane_28"
                app:tint="@color/light_bg1" />
            <TextView
                android:id="@+id/txtRecordAlert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="80"
                android:text="@string/lng_record_alert"
                android:textAlignment="center"
                android:textColor="@color/errcolo"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone" />



            <ImageButton
                android:id="@+id/sendImageBtn_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="10"
                android:background="@color/header_footer_bg"
                android:src="@drawable/paperclip_28"
                android:visibility="gone"
                app:tint="@color/light_bg1" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabPlayvoce"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:src="@drawable/volume_50"
                android:tint="#FFFFFF"
                android:visibility="gone"
                app:fabCustomSize="35dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabVoiceCancel"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:src="@drawable/circle_xmark_35"
                android:tint="#FFFFFF"
                android:visibility="gone"
                app:fabCustomSize="35dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>